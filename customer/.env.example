# Customer local development: browser -> /api -> React dev proxy -> http://127.0.0.1:8001
REACT_APP_API_URL=/api
PORT=3001

# Production when frontend and backend share a reverse proxy:
# REACT_APP_API_URL=/api

# Production when backend is deployed separately:
# REACT_APP_API_URL=https://YOUR_NTAXCO_BACKEND_DOMAIN/api
HOST=localhost
